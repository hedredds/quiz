{
  "relationships": {
    "id": "relationships",
    "title": "Отношения",
    "icon": "fa-heart",
    "color": "text-[var(--accent-pink)]",
    "blocks": {
      "b1": {
        "title": "Эмоции и поддержка",
        "questions": [
          {
            "id": "rel-1-1",
            "type": "choice",
            "text": "Когда тебе грустно, какая поддержка от меня работает лучше всего?",
            "options": [
              "Просто обнять и молчать",
              "Выслушать и дать совет",
              "Отвлечь чем-то веселым",
              "Оставить в покое ненадолго"
            ]
          },
          {
            "id": "rel-1-2",
            "type": "slider",
            "text": "Насколько легко тебе говорить мне о своих обидах, пока они не накопились?",
            "labels": [
              "Очень сложно",
              "Максимально легко"
            ]
          },
          {
            "id": "rel-1-3",
            "type": "boolean",
            "text": "Как думаешь, мы умеем экологично ссориться (без перехода на личности)?"
          }
        ]
      },
      "b2": {
        "title": "Личные границы",
        "questions": [
          {
            "id": "rel-2-1",
            "type": "boolean",
            "text": "Нормально ли для тебя, если я провожу выходной только со своими друзьями, без тебя?"
          },
          {
            "id": "rel-2-2",
            "type": "slider",
            "text": "Насколько тебе важно иметь время \"только для себя\" каждый день в полной тишине?",
            "labels": [
              "Не нужно",
              "Жизненно важно"
            ]
          },
          {
            "id": "rel-2-3",
            "type": "choice",
            "text": "Если наши планы на вечер кардинально расходятся, что будем делать?",
            "options": [
              "Найдем компромисс",
              "Проведем вечер порознь",
              "Уступит тот, кому менее важно",
              "Будем спорить до победного"
            ]
          }
        ]
      }
    }
  },
  "everyday": {
    "id": "everyday",
    "title": "Быт",
    "icon": "fa-house",
    "color": "text-[var(--accent-blue)]",
    "blocks": {
      "b1": {
        "title": "Дом и уют",
        "questions": [
          {
            "id": "ev-1-1",
            "type": "slider",
            "text": "Насколько тебя бесит немытая посуда или разбросанные вещи, оставленные на ночь?",
            "labels": [
              "Вообще всё равно",
              "Доводит до трясучки"
            ]
          },
          {
            "id": "ev-1-2",
            "type": "boolean",
            "text": "Считаешь ли ты, что домашние обязанности нужно делить строго 50/50, несмотря на работу?"
          },
          {
            "id": "ev-1-3",
            "type": "choice",
            "text": "Твой идеальный совместный выходной дома — это...",
            "options": [
              "Генеральная уборка под музыку",
              "Валяться в кровати с сериалом и доставкой еды",
              "Позвать гостей и накрыть стол",
              "Делать свои дела по разным комнатам"
            ]
          }
        ]
      }
    }
  },
  "sexy": {
    "id": "sexy",
    "title": "Секси",
    "icon": "fa-fire",
    "color": "text-[#ff5500]",
    "blocks": {
      "b1": {
        "title": "Желания и темп",
        "questions": [
          {
            "id": "sx-1-1",
            "type": "slider",
            "text": "Насколько сильно, по твоим ощущениям, совпадают наши темпераменты в постели?",
            "labels": [
              "Полный рассинхрон",
              "Идеальное совпадение"
            ]
          },
          {
            "id": "sx-1-2",
            "type": "choice",
            "text": "Кто, по-твоему, должен чаще проявлять инициативу в сексе?",
            "options": [
              "В основном я",
              "В основном ты",
              "Строго поровну",
              "Тот, кто больше хочет в моменте"
            ]
          },
          {
            "id": "sx-1-3",
            "type": "boolean",
            "text": "Стесняешься ли ты иногда предлагать мне новые смелые эксперименты?"
          }
        ]
      }
    }
  },
  "daily": {
    "id": "daily",
    "title": "Ежедневный",
    "icon": "fa-calendar-day",
    "color": "text-[#00d4ff]",
    "blocks": {
      "today": {
        "title": "Синхронизация дня",
        "questions": [
          {
            "id": "dq_1",
            "type": "slider",
            "text": "Как ты оценишь свой уровень энергии и настроения прямо сейчас?",
            "labels": [
              "На нуле",
              "Горы сверну"
            ]
          },
          {
            "id": "dq_2",
            "type": "boolean",
            "text": "Было ли сегодня что-то, что тебя сильно расстроило, обидело или напрягло?"
          },
          {
            "id": "dq_3",
            "type": "choice",
            "text": "Как бы ты хотел(а) провести остаток этого вечера?",
            "options": [
              "В тишине, не трогайте меня",
              "Активно и вне дома (прогулка, кафе)",
              "За душевным разговором со мной",
              "В обнимку под фильм"
            ]
          }
        ]
      }
    }
  }
}